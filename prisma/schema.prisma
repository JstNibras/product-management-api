
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id         Int      @id @default(autoincrement())
  externalId String   @unique
  name       String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
